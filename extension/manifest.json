{
  "manifest_version": 3,
  "name": "PatchPilot",
  "version": "2.0.0",
  "description": "Serve a local PCF bundle or Model-Driven JavaScript/HTML web resource into a running Dynamics 365 session, without redeploying.",
  "permissions": ["activeTab", "storage", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:32145/*", "https://*.dynamics.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "PatchPilot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [{ "matches": ["https://*.dynamics.com/*"], "js": ["indicator.js"], "run_at": "document_idle" }]
}
