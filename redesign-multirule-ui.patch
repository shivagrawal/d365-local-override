ter;justify-content:space-between;text-transform:none}.switch-row input{width:auto}.active{margin-top:8px;padding:8px;text-align:center;border:1px solid #abefc6;border-radius:7px;background:#ecfdf3;color:#067647;font-weight:800}.diagnostics-card summary,.guide summary{padding:10px 12px;cursor:pointer;font-weight:700}.diagnostics-card #diagnostics{padding:10px 12px;border-top:1px solid var(--border);color:var(--muted);font:11px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-line}#watchLog{max-height:220px;overflow-y:auto;padding:10px 12px;border-top:1px solid var(--border);background:#0b1220;color:#d1d5db;font:11px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;word-break:break-word}.guide ol{padding:2px 16px 8px 32px}.notice{padding:12px}.offline{background:#fffaeb}.error{margin-top:10px;padding:9px;border:1px solid #fecdca;border-radius:7px;background:#fef3f2;color:var(--danger);font-size:11px}button{font:inherit;cursor:pointer}.text-button{border:0;background:none;color:var(--primary);font-size:11px}#candidates{display:flex;flex-direction:column;gap:6px;margin-top:8px;max-height:220px;overflow-y:auto;overflow-x:hidden}#candidates button{width:100%;max-width:100%;text-align:left;white-space:normal;overflow-wrap:anywhere;word-break:break-all;padding:8px 9px;border:1px solid var(--border);border-radius:6px;background:#fff;font-size:11px;line-height:1.4}#candidates button:hover{background:var(--surface);border-color:var(--primary)}
+:root{
+  color-scheme: dark;
+  --panel:#0f1419; --panel-raised:#161d27; --panel-sunken:#0a0d12;
+  --stroke:#242e3a; --stroke-soft:#1a222c; --stroke-control:#5c6974;
+  --text:#e6edf3; --text-dim:#8b98a5; --text-faint:#79868f;
+  --amber:#f0a020; --amber-dim:#7a5620;
+  --cyan:#4fd1c5; --cyan-dim:#2c5551;
+  --red:#e5484d; --red-dim:#7a2e30;
+  --mono: ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;
+  --sans: system-ui,-apple-system,"Segoe UI",sans-serif;
+}
+*{box-sizing:border-box}
+body{margin:0;width:400px;max-height:600px;overflow-y:auto;background:var(--panel);color:var(--text);font:13px/1.45 var(--sans)}
+main{padding:12px}
+
+/* --- header: compact, live status instead of a separate banner --- */
+.app-header{display:flex;align-items:center;gap:9px;padding-bottom:10px;border-bottom:1px solid var(--stroke)}
+.brand-icon{display:block;width:26px;height:26px;border-radius:6px;flex-shrink:0}
+.app-header h1{margin:0;font-size:14px;font-weight:700;letter-spacing:-.01em}
+.version{margin-left:auto;color:var(--text-faint);font:11px var(--mono)}
+.live-status{display:flex;align-items:center;gap:6px;padding:8px 2px;font-size:12px;color:var(--text-dim)}
+.dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;background:var(--text-faint)}
+.dot.on{background:var(--amber);box-shadow:0 0 0 3px var(--amber-dim)}
+.dot.info{background:var(--cyan)}
+.dot.error{background:var(--red);box-shadow:0 0 0 3px var(--red-dim)}
+
+/* --- generic section / row primitives (list-based, not identical shadow cards) --- */
+.section{margin-top:12px}
+.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
+.section-title{font-size:11px;font-weight:700;color:var(--text-dim);text-transform:none}
+label{display:block;margin:8px 0 4px;color:var(--text-dim);font-size:11.5px;font-weight:600}
+.hint{margin:0 0 7px;color:var(--text-faint);font-size:11px;font-weight:400}
+.value-box{padding:7px 8px;border:1px solid var(--stroke);border-radius:5px;background:var(--panel-sunken);font:11.5px var(--mono);color:var(--text-dim);overflow-wrap:anywhere}
+.muted{color:var(--text-faint)}
+
+select,.path-input,input[type=url]{width:100%;min-height:32px;padding:6px 8px;border:1px solid var(--stroke-control);border-radius:5px;background:var(--panel-sunken);color:var(--text);font:12px var(--sans)}
+.path-input,input[type=url]{font:11.5px var(--mono)}
+select:focus,.path-input:focus,input:focus{outline:2px solid var(--cyan);outline-offset:1px}
+
+.command-row{display:flex;gap:5px;margin-top:6px}
+.command-row code{flex:1;padding:6px 7px;background:var(--panel-sunken);border:1px solid var(--stroke);border-radius:5px;font:10.5px var(--mono);color:var(--text-dim);overflow-wrap:anywhere}
+
+button{font:inherit;cursor:pointer}
+.primary-button,.secondary-button{min-height:32px;padding:6px 10px;border-radius:6px;margin-top:7px;font-size:12px;font-weight:600}
+.primary-button{border:1px solid var(--amber-dim);background:var(--amber);color:#241a04}
+.primary-button:hover{filter:brightness(1.08)}
+.secondary-button{border:1px solid var(--stroke-control);background:var(--panel-raised);color:var(--text)}
+.secondary-button:hover{border-color:var(--text-faint)}
+.full-width{width:100%}
+.text-button{border:0;background:none;color:var(--cyan);font-size:11px;padding:0}
+button:disabled{opacity:.5;cursor:default}
+
+.switch-row{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--text);text-transform:none;font-weight:500}
+.switch-row input{width:auto}
+
+.hidden{display:none!important}
+
+/* --- override rows: the core new UI, replaces the single-slot form --- */
+.override-row{display:flex;align-items:center;gap:8px;padding:7px 8px;margin-top:6px;border:1px solid var(--stroke);border-radius:6px;background:var(--panel-raised)}
+.override-row .dot{margin-top:0}
+.override-row .mapping{flex:1;min-width:0;font:11px var(--mono);color:var(--text)}
+.override-row .mapping .local{color:var(--text-dim)}
+.override-row .mapping div{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.row-action{border:0;background:none;color:var(--text-faint);font-size:14px;line-height:1;padding:3px 4px;border-radius:4px}
+.row-action:hover{background:var(--stroke-soft);color:var(--text)}
+.row-action.danger:hover{color:var(--red)}
+.empty-state{padding:14px 8px;text-align:center;color:var(--text-faint);font-size:11.5px;border:1px dashed var(--stroke);border-radius:6px;margin-top:6px}
+
+/* --- add-override panel: revealed on demand, not permanently on screen --- */
+.add-panel{margin-top:8px;padding:9px;border:1px solid var(--stroke);border-radius:7px;background:var(--panel-sunken)}
+#candidates{display:flex;flex-direction:column;gap:5px;margin-top:7px;max-height:200px;overflow-y:auto}
+#candidates button{width:100%;text-align:left;white-space:normal;overflow-wrap:anywhere;word-break:break-all;padding:6px 7px;border:1px solid var(--stroke);border-radius:5px;background:var(--panel-raised);font:11px var(--mono);color:var(--text-dim)}
+#candidates button:hover{border-color:var(--cyan);color:var(--text)}
+
+/* --- build watch log: instrument-style readout --- */
+.log-panel{max-height:200px;overflow-y:auto;padding:8px 9px;border:1px solid var(--stroke);border-radius:6px;background:var(--panel-sunken);color:#a6b0bb;font:10.5px/1.5 var(--mono);white-space:pre-wrap;word-break:break-word;margin-top:6px}
+
+details{border:1px solid var(--stroke);border-radius:7px;background:var(--panel-raised);margin-top:8px}
+details summary{padding:8px 10px;cursor:pointer;font-size:11.5px;font-weight:600;color:var(--text-dim)}
+details[open] summary{border-bottom:1px solid var(--stroke)}
+details .body{padding:9px 10px}
+.guide ol{margin:0;padding:2px 10px 6px 22px;font-size:11.5px;color:var(--text-dim)}
+.guide li{margin-bottom:6px}
+.guide li p{margin:2px 0 0;color:var(--text-faint)}
+
+.notice{padding:10px;border:1px solid var(--stroke);border-radius:8px;background:var(--panel-raised)}
+.notice-title{font-size:12px;font-weight:700;color:var(--text);margin-bottom:2px}
+.error{margin-top:9px;padding:8px 9px;border:1px solid var(--red-dim);border-radius:6px;background:#2a1214;color:#ff9c9f;font-size:11px}
